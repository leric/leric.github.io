---
import { getCollection, render } from 'astro:content';
import ResearchChapterLayout from '../../../../../layouts/ResearchChapterLayout.astro';
import {
	getCmpChapters,
	getAdjacentChapters,
	isCmpChapterRenderable,
	parseCmpEntryId,
	findCmpTranslation,
	cmpBookPath,
} from '../../../../../lib/research-cmp';
import { AUTHOR_JSON_LD } from '../../../../../consts';

export async function getStaticPaths() {
	const all = await getCollection('research');
	const paths = [];
	for (const entry of all) {
		if (!isCmpChapterRenderable(entry.data.status)) continue;
		const p = parseCmpEntryId(entry.id);
		if (!p || p.lang !== 'zh') continue;
		paths.push({ params: { part: p.part, slug: p.slug }, props: { entry } });
	}
	return paths;
}

const { entry } = Astro.props;

const all = await getCollection('research');
const cmpChapters = getCmpChapters(all, 'zh');
const renderable = cmpChapters.filter((c) => isCmpChapterRenderable(c.data.status));
const { prev, next } = getAdjacentChapters(renderable, entry.id);
const translation = findCmpTranslation(all, entry, 'en');

const { Content } = await render(entry);

const pageTitle = `${entry.data.title} · CMP 中文版 · Context Cost`;
const ogImage = entry.data.standalone?.ogImage;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: entry.data.title,
	description: entry.data.description,
	inLanguage: 'zh-CN',
	datePublished: entry.data.pubDate.toISOString(),
	dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
	url: entry.data.canonicalUrl,
	author: AUTHOR_JSON_LD,
	isPartOf: {
		'@type': 'Book',
		name: '上下文最小化原则',
		url: new URL(cmpBookPath('zh'), Astro.site).href,
	},
};
---

<ResearchChapterLayout
	entry={entry}
	title={pageTitle}
	description={entry.data.description}
	canonicalUrl={entry.data.canonicalUrl}
	image={ogImage}
	jsonLd={jsonLd}
	allChapters={cmpChapters}
	prev={prev}
	next={next}
	translation={translation}
>
	<Content />
</ResearchChapterLayout>
